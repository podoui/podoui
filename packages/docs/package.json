{
  "name": "@podoui/docs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Podo UI documentation site. Renders live @podoui/react components.",
  "scripts": {
    "predev": "tsc -b ../core ../react ../tokens",
    "dev": "vite",
    "prebuild": "tsc -b ../core ../react ../tokens",
    "build": "vite build",
    "typecheck": "tsc -b tsconfig.json",
    "preview": "vite preview",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@podoui/react": "workspace:*",
    "@podoui/tokens": "workspace:*",
    "podo-ui": "workspace:*",
    "pretendard": "^1.3.9",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
